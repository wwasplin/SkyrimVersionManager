<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkyrimVersionManager</RootNamespace>
    <AssemblyName>SkyrimVersionManager</AssemblyName>
    <Version>1.0.2</Version>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Description>Manage installed Skyrim Special Edition versions (Steam)</Description>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="versions.json" />
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
